{
  "name": "joineazy-backend",
  "version": "1.0.0",
  "description": "Joineazy Student, Group & Assignment Management System - Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
